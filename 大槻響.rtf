\
let currentQ = 0;\
let scores = \{ landlord: 0, nurse: 0, wife: 0 \};\
\
function showScreen(id) \{\
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));\
  document.getElementById(id).classList.add('active');\
\}\
\
function startQuiz() \{\
  currentQ = 0;\
  scores = \{ landlord: 0, nurse: 0, wife: 0 \};\
  showScreen('screen-quiz');\
  renderQuestion();\
\}\
\
function renderQuestion() \{\
  const q = questions[currentQ];\
  const pct = Math.round((currentQ / questions.length) * 100);\
  document.getElementById('prog-text').textContent = `SCENE $\{String(currentQ+1).padStart(2,'0')\} / 06`;\
  document.getElementById('prog-pct').textContent = `$\{pct\}%`;\
  document.getElementById('prog-fill').style.width = `$\{pct\}%`;\
  document.getElementById('scene-tag').textContent = q.scene;\
  document.getElementById('q-num').textContent = String(currentQ+1).padStart(2,'0');\
  document.getElementById('q-text').textContent = q.text;\
  document.getElementById('q-context').textContent = q.context;\
\
  const grid = document.getElementById('options-grid');\
  const labels = ['A', 'B', 'C', 'D'];\
  grid.innerHTML = q.options.map((opt, i) => `\
    <button class="option-btn" onclick="selectOption(this, $\{i\})">\
      <span class="option-label">$\{labels[i]\}</span>$\{opt.text\}\
    </button>\
  `).join('');\
\}\
\
function selectOption(btn, idx) \{\
  btn.classList.add('selected');\
  const opt = questions[currentQ].options[idx];\
  Object.keys(opt.scores).forEach(k => scores[k] += opt.scores[k]);\
\
  setTimeout(() => \{\
    currentQ++;\
    if (currentQ < questions.length) \{\
      renderQuestion();\
    \} else \{\
      showScreen('screen-loading');\
      setTimeout(showResult, 2200);\
    \}\
  \}, 500);\
\}\
\
function showResult() \{\
  const winner = Object.entries(scores).sort((a,b) => b[1]-a[1])[0][0];\
  const r = results[winner];\
\
  document.getElementById('screen-result').className = `screen $\{r.theme\}`;\
  document.getElementById('r-label').textContent = r.label;\
  document.getElementById('r-badge').textContent = r.badge;\
  document.getElementById('r-title').textContent = r.title;\
  document.getElementById('r-quote').textContent = r.quote;\
  document.getElementById('r-desc').textContent = r.desc;\
\
  // \uc0\u22871 \u29992 \u21508 \u32080 \u23616 \u30340 \u22294 \u29255 \
  const img = document.getElementById('poster-img');\
  const placeholder = document.getElementById('poster-placeholder');\
  img.src = r.image;\
  img.style.display = 'block';\
  placeholder.style.display = 'none';\
\
  // \uc0\u22871 \u29992 \u21508 \u32080 \u23616 \u30340  CTA\
  const btn = document.getElementById('cta-preview-btn');\
  btn.textContent = r.ctaText;\
  btn.href = r.ctaLink;\
\
  // \uc0\u38577 \u34255 \u32232 \u36655 \u22120 \u65288 \u35370 \u23458 \u19981 \u38656 \u35201 \u30475 \u21040 \u65289 \
  document.querySelector('.cta-editor').style.display = 'none';\
\
  showScreen('screen-result');\
\
  // Animate bar\
  setTimeout(() => \{\
    document.getElementById('r-bar').style.width = `$\{r.percent\}%`;\
    let n = 0;\
    const el = document.getElementById('r-pct');\
    const interval = setInterval(() => \{\
      n++;\
      el.textContent = n + '%';\
      if (n >= r.percent) clearInterval(interval);\
    \}, 18);\
  \}, 300);\
\}\
\
function handlePosterUpload(event) \{\
  const file = event.target.files[0];\
  if (!file) return;\
  const reader = new FileReader();\
  reader.onload = (e) => \{\
    const img = document.getElementById('poster-img');\
    img.src = e.target.result;\
    img.style.display = 'block';\
    document.getElementById('poster-placeholder').style.display = 'none';\
  \};\
  reader.readAsDataURL(file);\
\}\
\
function updateCTA() \{\
  const text = document.getElementById('cta-text-input').value.trim();\
  const link = document.getElementById('cta-link-input').value.trim();\
  const btn = document.getElementById('cta-preview-btn');\
  btn.textContent = text || '\uc0\u31435 \u21363 \u38928 \u32004 \u35211 \u38754 \u26371 ';\
  btn.href = link || '#';\
\}\
\
\
function restartQuiz() \{\
  document.getElementById('screen-result').className = 'screen';\
  startQuiz();\
\}\
\
// Generate particles\
function initParticles() \{\
  const container = document.getElementById('particles');\
  const colors = ['#ff2d78', '#00f5ff', '#bf5fff', '#ffd700'];\
  for (let i = 0; i < 35; i++) \{\
    const p = document.createElement('div');\
    p.className = 'particle';\
    p.style.cssText = `\
      left: $\{Math.random() * 100\}%;\
      width: $\{Math.random() < 0.5 ? 2 : 3\}px;\
      height: $\{Math.random() < 0.5 ? 2 : 3\}px;\
      background: $\{colors[Math.floor(Math.random() * colors.length)]\};\
      box-shadow: 0 0 6px $\{colors[Math.floor(Math.random() * colors.length)]\};\
      animation-duration: $\{6 + Math.random() * 12\}s;\
      animation-delay: $\{Math.random() * 10\}s;\
      --drift: $\{(Math.random() - 0.5) * 100\}px;\
    `;\
    container.appendChild(p);\
  \}\
\}\
\
initParticles();\
</script>\
